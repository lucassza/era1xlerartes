APP_NAME="TDB Mix Blog"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tdb_mix_blog
DB_DATABASE_TEST=tdb_mix_blog_test
DB_TEST_HOST=postgres
DB_TEST_PORT=5432
DB_TEST_DATABASE=tdb_mix_blog_test
DB_TEST_USERNAME=tdb
DB_TEST_PASSWORD=secret
DB_USERNAME=tdb
DB_PASSWORD=secret
DB_CHARSET=utf8
DB_SSLMODE=prefer

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

CACHE_PREFIX=tdb-mix-blog-cache-
REDIS_PREFIX=tdb-mix-blog-database-
SESSION_COOKIE=tdb-mix-blog-session

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=s3
MEDIA_DISK=s3
MEDIA_CONVERSIONS_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminsecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=blog
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/blog
AWS_USE_PATH_STYLE_ENDPOINT=true

AWS_VISIBILITY=private
IMAGE_DRIVER=imagick
MEDIA_QUEUE=media
QUEUE_CONVERSIONS_BY_DEFAULT=true
QUEUE_CONVERSIONS_AFTER_DB_COMMIT=true

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

VITE_APP_NAME="${APP_NAME}"

PHP_VERSION=8.5
