APP_NAME="Era1x Ler Artes"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql_testing
DB_TEST_HOST=postgres
DB_TEST_PORT=5432
DB_TEST_DATABASE=era1x_ler_artes_test
DB_TEST_USERNAME=era1x
DB_TEST_PASSWORD=secret
DB_TEST_CHARSET=utf8
DB_TEST_SSLMODE=prefer

SESSION_DRIVER=array
SESSION_CONNECTION=null
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=era1x-ler-artes-testing

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync

CACHE_STORE=array
CACHE_PREFIX=era1x-ler-artes-testing-cache-

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379
REDIS_DB=2
REDIS_CACHE_DB=3
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_PREFIX=era1x-ler-artes-testing-database-

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminsecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=blog
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/blog
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_VISIBILITY=private

MEDIA_DISK=s3
MEDIA_CONVERSIONS_DISK=s3
IMAGE_DRIVER=imagick
MEDIA_QUEUE=media
QUEUE_CONVERSIONS_BY_DEFAULT=false
QUEUE_CONVERSIONS_AFTER_DB_COMMIT=true

VITE_APP_NAME="${APP_NAME}"
