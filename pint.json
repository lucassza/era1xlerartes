{
    "preset": "laravel",
    "rules": {
        "Pint/phpdoc_type_annotations_only": true,
        "declare_strict_types": true,
        "ordered_imports": {
            "sort_algorithm": "alpha",
            "imports_order": ["class", "function", "const"]
        },
        "trailing_comma_in_multiline": true,
        "no_unused_imports": true
    },
    "exclude": [
        "bootstrap/cache",
        "storage/framework",
        "vendor"
    ]
}
